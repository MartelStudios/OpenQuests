character.kweebec-child.epithet=Enfant curieux
character.kweebec-farmer.epithet=Fermier
character.kweebec-mage.epithet=Mage
character.kweebec-villager.name=Kweebec
dialogue.kweebec-child.text=Tu crois que les scarabées rêvent ? J'en ai demandé un, il n'a pas répondu.
dialogue.kweebec-child.bye=Peut-être bien.
dialogue.kweebec-farmer.text=La terre est généreuse cette saison. Prends garde aux pousses en passant.
dialogue.kweebec-farmer.bye=Promis.
dialogue.kweebec-mage.text=Les racines bourdonnent ce soir. Quelque chose d'ancien remue sous la forêt.
dialogue.kweebec-mage.bye=Je garderai l'oreille tendue.
names.kweebec-names.name.bramble=Ronce
names.kweebec-names.name.fern=Fougère
names.kweebec-names.name.moss=Mousse
names.kweebec-names.name.sorrel=Oseille
quest.kweebec-farewell.title=Gare aux pousses
quest.kweebec-farewell.description=Le fermier s'inquiète pour ses pousses. Promettez-lui de faire attention en passant.
quest.kweebec-farewell.short=Promettre au fermier de faire attention aux pousses
quest.kweebec-fibres.title=Des fibres pour le fermier
quest.kweebec-fibres.description=Le fermier a besoin de fibres de plante et de bâtons pour attacher ses pousses. Apportez-les en une fois ou petit à petit.
quest.kweebec-fibres.short=Apporter 10 fibres de plante et 5 bâtons au fermier
quest.kweebec-mage.title=Le seul mage
quest.kweebec-mage.description=Il n'existe qu'un seul mage kweebec sur toutes les terres, et les racines parlent à travers lui. Trouvez-le avant qu'il ne soit trop tard.
quest.kweebec-mage.short=Parler au mage kweebec
quest.kweebec-talk.title=Un mot au fermier
quest.kweebec-talk.description=Le village kweebec a un fermier qui connaît chaque pousse par son nom. Allez le saluer.
quest.kweebec-talk.short=Parler au fermier du village
