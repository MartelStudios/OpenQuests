// One step of the trail: the separator before it, then its name. The separator is hidden on the
// first crumb rather than drawn by the page, so a crumb stays one appended document either way.
$P = "QuestPageCommon.ui";

// No width anywhere, not even a maximum: an element given a MaxWidth grows to it, while one given
// none is only as wide as its text, so the steps sit side by side with only the separator between.
Group #Crumb {
  LayoutMode: Left;
  Anchor: (Height: 20);

  Label #Separator { Text: ">"; Padding: (Horizontal: 6); Style: (...$P.@RowStatusStyle, HorizontalAlignment: Center); }

  // A crumb the player can go back to; #Here is the same name for the page they are already on
  TextButton #Link { Text: ""; Style: $P.@LinkStyle; Visible: false; }
  Label #Here { Text: ""; Style: (...$P.@RowStatusStyle, HorizontalAlignment: Start); Visible: false; }
}
