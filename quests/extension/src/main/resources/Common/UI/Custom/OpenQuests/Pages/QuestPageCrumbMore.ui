// The mark standing for the steps the trail left out. Its own document rather than a crumb with a
// short name, so it never carries a link nor the cap a quest title needs.
$P = "QuestPageCommon.ui";

Group #CrumbMore {
  LayoutMode: Left;
  Anchor: (Height: 20);

  Label #Separator { Text: ">"; Padding: (Horizontal: 6); Style: (...$P.@RowStatusStyle, HorizontalAlignment: Center); }
  Label #Here { Text: "..."; Style: (...$P.@RowStatusStyle, HorizontalAlignment: Start); }
}
