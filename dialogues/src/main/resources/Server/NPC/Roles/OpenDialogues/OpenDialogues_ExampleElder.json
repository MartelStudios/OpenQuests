{
  "Type": "Generic",
  "Parameters": {
    "NameTranslationKey": {
      "Value": "opendialogues.example.npc.elder.name",
      "Description": "Display name of the example elder"
    }
  },
  "StartState": "Idle",
  "DefaultPlayerAttitude": "Neutral",
  "Appearance": "Kweebec_Sapling_Treesinger",
  "MaxHealth": 100,
  "Invulnerable": true,
  "KnockbackScale": 0.0,
  "BusyStates": [ "$Interaction" ],
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 5,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": { "Type": "State", "State": "Idle" },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": { "Type": "Player", "Range": 8 },
          "HeadMotion": { "Type": "Watch" }
        },
        { "Sensor": { "Type": "Any" }, "BodyMotion": { "Type": "Nothing" } }
      ]
    },
    {
      "Sensor": { "Type": "State", "State": "$Interaction" },
      "Actions": [
        {
          "Type": "Timeout",
          "Delay": [ 1, 1 ],
          "Action": {
            "Type": "Sequence",
            "Actions": [ { "Type": "ReleaseTarget" }, { "Type": "State", "State": "Idle" } ]
          }
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": { "Type": "Not", "Sensor": { "Type": "CanInteract", "ViewSector": 180 } },
        "Actions": [ { "Type": "SetInteractable", "Interactable": false } ]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [ { "Type": "LockOnInteractionTarget" } ]
      },
      {
        "Sensor": { "Type": "Not", "Sensor": { "Type": "Target", "Range": 3 } },
        "Actions": [ { "Type": "SetInteractable", "Interactable": false } ]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [ { "Type": "SetInteractable", "Interactable": true, "Hint": "opendialogues.example.npc.hint" } ]
      },
      {
        "Sensor": { "Type": "And", "Sensors": [ { "Type": "HasInteracted" }, { "Type": "Not", "Sensor": { "Type": "State", "State": "$Interaction" } } ] },
        "Actions": [
          { "Type": "OpenDialoguesOpen", "Dialogue": "OpenDialogues_ExampleElder" },
          { "Type": "State", "State": "$Interaction" }
        ]
      }
    ]
  },
  "NameTranslationKey": { "Compute": "NameTranslationKey" }
}
