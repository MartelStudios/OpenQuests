// One answer of a dialogue, appended into #Answers of DialoguePage.ui. Answers are sentences, so
// the label keeps their case and reads from the left, unlike vanilla buttons.
$C = "../../Common.ui";

@AnswerLabelStyle = LabelStyle(FontSize: 15, TextColor: #d8dee6, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@AnswerHoveredLabelStyle = LabelStyle(...@AnswerLabelStyle, TextColor: #ffffff);

TextButton #Answer {
  Text: "";
  Anchor: (Height: 44, Bottom: 6);
  Padding: (Horizontal: 14);
  Style: TextButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary.png", Border: $C.@ButtonBorder), LabelStyle: @AnswerLabelStyle),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Hovered.png", Border: $C.@ButtonBorder), LabelStyle: @AnswerHoveredLabelStyle),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Pressed.png", Border: $C.@ButtonBorder), LabelStyle: @AnswerHoveredLabelStyle),
    Sounds: $C.@ButtonSounds
  );
}
