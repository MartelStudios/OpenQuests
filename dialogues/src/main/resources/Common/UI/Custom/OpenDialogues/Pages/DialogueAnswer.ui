// One answer of a dialogue, appended into #Answers of DialoguePage.ui. Answers are sentences, so
// the label keeps their case and reads from the left, unlike vanilla buttons.
// DialogueCustomPage retints the three backgrounds from the answer's colour (#ffffff leaves the
// vanilla texture as is) and fills #Icon. #IconSlot keeps its width without an icon so texts line up.
$C = "../../Common.ui";

@AnswerLabelStyle = LabelStyle(FontSize: 15, TextColor: #d8dee6, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);

Button #Answer {
  LayoutMode: Left;
  Anchor: (Height: 44, Bottom: 6);
  Padding: (Horizontal: 14);
  Style: ButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary.png", Border: $C.@ButtonBorder, Color: #ffffff)),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Hovered.png", Border: $C.@ButtonBorder, Color: #ffffff)),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Pressed.png", Border: $C.@ButtonBorder, Color: #ffffff)),
    Sounds: $C.@ButtonSounds
  );

  Group #IconSlot {
    Anchor: (Width: 28, Height: 20);

    AssetImage #Icon {
      Anchor: (Width: 20, Height: 20);
      Visible: false;
    }
  }

  Label #Label {
    FlexWeight: 1;
    Text: "";
    Style: @AnswerLabelStyle;
  }
}
