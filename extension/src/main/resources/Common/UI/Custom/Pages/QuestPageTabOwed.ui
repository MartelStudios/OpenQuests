// The rewards tab while something is waiting on it. Same tab as QuestPageTab.ui, wearing the gold
// a claim button wears, so a debt is visible from whichever tab the player is standing on. The page
// picks between the two documents, which is what keeps the colour here rather than in Java.
$C = "../Common.ui";
$P = "QuestPageCommon.ui";

TextButton #Tab {
  Text: "";
  Anchor: (Width: 104, Height: 30, Right: 4);
  Padding: (Horizontal: 16);
  Style: $P.@OwedButtonStyle;
}
