// One step of the trail: the separator before it, then its name. The separator is hidden on the
// first crumb rather than drawn by the page, so a crumb stays one appended document either way.
$P = "QuestPageCommon.ui";

// A width rather than a share of the row: nothing here sizes to its text, and a crumb given a
// share stretches to fill it, which spreads a four-step trail across the whole page. The page
// measures each name and sends the width along with the crumb, so what stands here is only what a
// crumb falls back to.
Group #Crumb {
  LayoutMode: Left;
  Anchor: (Width: 150, Height: 20);

  Label #Separator { Text: ">"; Anchor: (Width: 14); Style: (...$P.@RowStatusStyle, HorizontalAlignment: Center); }

  // A crumb the player can go back to; #Here is the same name for the page they are already on
  TextButton #Link { Text: ""; FlexWeight: 1; Style: $P.@LinkStyle; Visible: false; }
  Label #Here { Text: ""; FlexWeight: 1; Style: (...$P.@RowStatusStyle, HorizontalAlignment: Start); Visible: false; }
}
