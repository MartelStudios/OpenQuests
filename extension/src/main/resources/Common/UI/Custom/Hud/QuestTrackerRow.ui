// One quest. Appended into whatever container is being filled, addressed as "<container>[i] #Title".
$Rows = "QuestTrackerCommon.ui";

Group #QuestRow {
  Anchor: (Top: 12);

  Group #IconDefault { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: $Rows.@QuestIconDefault; }
  Group #IconComplete { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: $Rows.@QuestIconComplete; Visible: false; }

  Label #Title { Text: ""; Anchor: (Left: 20, Width: 230); Style: $Rows.@QuestTitleStyle; }
  Label #Progress { Text: ""; Style: $Rows.@QuestProgressStyle; }
}
