@ColorQuestTitle = #E8A93B;      // @ColorGoldHighlight
@ColorQuestProgress = #bfcdd5;   // @ColorButtonText
@ColorQuestComplete = #797b7c;   // @ColorDisabled

@QuestTitleStyle = (FontSize: 15, RenderBold: true, LetterSpacing: 1, TextColor: @ColorQuestTitle, VerticalAlignment: Center, Wrap: true);

@QuestProgressStyle = (FontSize: 15, RenderBold: true, LetterSpacing: 1, TextColor: @ColorQuestProgress, HorizontalAlignment: End, VerticalAlignment: Center);

@QuestIconDefault = PatchStyle(TexturePath: "ObjectiveTaskIconDefault.png");

@QuestIconComplete = PatchStyle(TexturePath: "ObjectiveTaskIconComplete.png");

Group #QuestRow {
  Anchor: (Top: 12);

  Group #IconDefault { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: @QuestIconDefault; }
  Group #IconComplete { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: @QuestIconComplete; Visible: false; }

  Label #Title { Text: ""; Anchor: (Left: 20, Width: 230); Style: @QuestTitleStyle; }
  Label #Progress { Text: ""; Style: @QuestProgressStyle; }
}
