// One sub-quest, shifted right. There is only ever one level of nesting: a sub-quest of a
// sub-quest is shown here too, since a deeper indent would say nothing more.

// Taken from the shared palette in Common/UI/Custom/Common.ui, kept as values rather than as a
// $C import: a document appended by the server is parsed on its own, and reaching another pack
// from there is unverified. The names say where each one comes from.
@ColorQuestTitle = #E8A93B;      // @ColorGoldHighlight
@ColorQuestProgress = #bfcdd5;   // @ColorButtonText
@ColorQuestComplete = #797b7c;   // @ColorDisabled

@QuestTitleStyle = (FontSize: 15, RenderBold: true, LetterSpacing: 1, TextColor: @ColorQuestTitle, VerticalAlignment: Center, Wrap: true);

@QuestProgressStyle = (FontSize: 15, RenderBold: true, LetterSpacing: 1, TextColor: @ColorQuestProgress, HorizontalAlignment: End, VerticalAlignment: Center);

@QuestIconDefault = PatchStyle(TexturePath: "ObjectiveTaskIconDefault.png");

@QuestIconComplete = PatchStyle(TexturePath: "ObjectiveTaskIconComplete.png");

Group #QuestRow {
  Anchor: (Top: 8);

  Group #IconDefault { Anchor: (Width: 14, Height: 14, Top: 4, Left: 20); Background: @QuestIconDefault; }
  Group #IconComplete { Anchor: (Width: 14, Height: 14, Top: 4, Left: 20); Background: @QuestIconComplete; Visible: false; }

  Label #Title { Text: ""; Anchor: (Left: 40, Width: 210); Style: @QuestTitleStyle; }
  Label #Progress { Text: ""; Style: @QuestProgressStyle; }
}
