// Shared by the quest page documents. An appended document is parsed on its own, so each one
// imports what it needs from here rather than the page declaring it once for everybody.
$C = "../../Common.ui";

@ColorTitle = $C.@ColorDefault;
@ColorMuted = $C.@ColorDefaultLabel;
@ColorDone = $C.@ColorDisabled;
@ColorAccent = $C.@ColorGoldHighlight;

// A figure column wide enough for a counter or a short state word, the same on every line so the
// two kinds of detail line agree on where the right-hand column starts.
@ValueWidth = 110;

// Wider for the rules a quest runs under, whose figure is a sentence: "Again in 19 h 59 min".
@ConditionValueWidth = 220;

@RowTitleStyle = (FontSize: 14, RenderBold: true, TextColor: @ColorTitle, VerticalAlignment: Center);

// A category's name; the page writes the colour each category asks for over this one
@CategoryStyle = (FontSize: 11, RenderBold: true, TextColor: #d9e1ee, VerticalAlignment: Center);
@RowStatusStyle = (FontSize: 12, RenderBold: true, TextColor: @ColorAccent, VerticalAlignment: Center, HorizontalAlignment: End);
@RowTextStyle = (FontSize: 12, TextColor: @ColorMuted, Wrap: true);

// Held to one line, since a detail line is a fixed height. A long title that wrapped would spill
// out of its row rather than push it taller.
@LineLabelStyle = (FontSize: 12, TextColor: @ColorMuted, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
@SectionStyle = (FontSize: 11, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @ColorMuted);
@ProgressStyle = (FontSize: 12, RenderBold: true, TextColor: @ColorMuted, HorizontalAlignment: End, VerticalAlignment: Center);
@SeparatorLabelStyle = (FontSize: 11, RenderBold: true, LetterSpacing: 1, TextColor: @ColorMuted, HorizontalAlignment: Center, VerticalAlignment: Center);

// Laid over every other line so the eye keeps the row while crossing from a label on the left to
// its figure on the right. @ColorBlueAccent at 6%, faint enough to read as banding rather than as
// a state. Referenced from QuestPageRows, so the shade is tuned here and nowhere else.
@StripeBackground = PatchStyle(Color: #7a9cc6(0.06));

// The frame the client puts round a selected input box, borrowed to say a quest is on the HUD.
// Gold on the same dark blue the row already sits on, so tracking reads as a state of the row
// rather than as a row of another kind. Set from QuestPageRows.
@TrackedRowBackground = PatchStyle(TexturePath: "../../Common/InputBoxSelected.png", Border: 16);

// The tracker's own marks, so a quest reads the same on the HUD and in the journal. Paths resolve
// against this file. Set from QuestPageRows, and left unset for a line that states nothing.
@QuestIconDefault = PatchStyle(TexturePath: "../Hud/ObjectiveTaskIconDefault.png");
@QuestIconComplete = PatchStyle(TexturePath: "../Hud/ObjectiveTaskIconComplete.png");
@QuestIconFailed = PatchStyle(TexturePath: "../Hud/ObjectiveTaskIconFailed.png");
@QuestIconAbandoned = PatchStyle(TexturePath: "../Hud/ObjectiveTaskIconAbandoned.png");
@QuestIconLocked = PatchStyle(TexturePath: "../Hud/ObjectiveTaskIconLocked.png");
@QuestIconLost = PatchStyle(TexturePath: "../Hud/ObjectiveTaskIconLost.png");

// The client's own dropdown caret, borrowed to say that finishing a quest opens onto another
@QuestIconNext = PatchStyle(TexturePath: "../../Common/DropdownPressedCaret.png");

// The fold mark at the head of a row, and the row's header, which is what a click folds on
@ToggleLabelStyle = (FontSize: 14, RenderBold: true, TextColor: @ColorMuted, HorizontalAlignment: Center, VerticalAlignment: Center);

@HeaderStyle = ButtonStyle(
  Default: (Background: #000000(0)),
  Hovered: (Background: #ffffff(0.03)),
  Pressed: (Background: #000000(0.1)),
  Sounds: $C.@ButtonSounds
);

// A title that navigates rather than a button that acts: no frame at rest, the accent blue the
// rest of the client uses for links, and a colour shift to say it answers the mouse.
@LinkLabelStyle = (FontSize: 12, TextColor: $C.@ColorBlueAccent, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);

@LinkStyle = TextButtonStyle(
  Default: (Background: (Color: #000000(0)), LabelStyle: @LinkLabelStyle),
  Hovered: (Background: (Color: #000000(0)), LabelStyle: (...@LinkLabelStyle, TextColor: $C.@ColorBlueAccentHovered)),
  Pressed: (Background: (Color: #000000(0)), LabelStyle: (...@LinkLabelStyle, TextColor: $C.@ColorBlueAccentPressed)),
  Sounds: $C.@ButtonSounds
);

// What the client frames an active tertiary control with: an opaque gold border over a brown fill
// at 30% opacity, so it darkens the page rather than lightening it and the label keeps the same
// grey every other small button wears. There is no hovered variant of the texture, so the three
// live states are the one patch.
@OwedButtonBackground = PatchStyle(TexturePath: "../../Common/Buttons/Tertiary_Active.png", Border: $C.@ButtonBorder);

@OwedButtonStyle = TextButtonStyle(
  Default: (Background: @OwedButtonBackground, LabelStyle: $C.@SmallSecondaryButtonLabelStyle),
  Hovered: (Background: @OwedButtonBackground, LabelStyle: $C.@SmallSecondaryButtonLabelStyle),
  Pressed: (Background: @OwedButtonBackground, LabelStyle: $C.@SmallSecondaryButtonLabelStyle),

  // The open tab is drawn disabled, which is what marks it. A tab the player is standing on has no
  // news left to give, so it drops the gold with everything else.
  Disabled: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallButtonDisabledLabelStyle),
  Sounds: $C.@ButtonSounds
);

// The chapters tab's table of contents. A group header reads as a heading that folds; a chapter as
// a line under it. The open chapter wears the Open styles, swapped in by QuestPage.
@ChapterGroupLabelStyle = (FontSize: 13, RenderBold: true, TextColor: @ColorTitle, HorizontalAlignment: Start, VerticalAlignment: Center);

@ChapterGroupStyle = ButtonStyle(
  Default: (Background: #1e2a38),
  Hovered: (Background: #2a3a4e),
  Pressed: (Background: #142030),
  Sounds: $C.@ButtonSounds
);

@ChapterLabelStyle = (FontSize: 12, TextColor: @ColorMuted, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
@ChapterOpenLabelStyle = (...@ChapterLabelStyle, RenderBold: true, TextColor: @ColorAccent);

@ChapterStyle = ButtonStyle(
  Default: (Background: #000000(0)),
  Hovered: (Background: #2a3a4e),
  Pressed: (Background: #142030),
  Sounds: $C.@ButtonSounds
);

@ChapterOpenStyle = ButtonStyle(
  Default: (Background: #2c3a52),
  Hovered: (Background: #2c3a52),
  Pressed: (Background: #2c3a52),
  Sounds: $C.@ButtonSounds
);

// The client's own red for a button that cannot be taken back, at the small button's size
@DestructiveButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Destructive.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallSecondaryButtonLabelStyle),
  Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Destructive_Hovered.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallSecondaryButtonLabelStyle),
  Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Destructive_Pressed.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallSecondaryButtonLabelStyle),
  Sounds: $C.@ButtonDestructiveSounds
);
