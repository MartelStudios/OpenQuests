// The quest journal. Rows are not declared here: the page ships an empty #QuestList that
// QuestPage fills by appending QuestPageRow.ui, so it grows with what the player holds.
$C = "../../Common.ui";
$P = "QuestPageCommon.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Width: 900, Height: 700);

  #Content {
    LayoutMode: Top;

    Group #HeaderRow {
      LayoutMode: Left;
      Anchor: (Height: 34);

      Label #PageTitle { Text: ""; FlexWeight: 1; Style: (...$C.@TitleStyle, FontSize: 20); }
      Label #Counts { Text: ""; Anchor: (Width: 220); Style: $P.@RowStatusStyle; }
    }

    $C.@ContentSeparator { Anchor: (Top: 4, Bottom: 8); }

    // Filled by the page rather than declared here, so the tab standing open follows the state
    Group #Tabs {
      LayoutMode: Left;
      Anchor: (Height: 32);
    }

    // Tools of the open list, on a line of their own so the tabs keep the whole width. Hidden by
    // the page where it shows a single quest.
    Group #ListTools {
      LayoutMode: Left;
      Anchor: (Height: 32, Top: 8);
      Visible: false;

      // Narrows the open list by title. Each tab keeps its own text, which the page writes back
      // on switching tab and otherwise leaves to the player typing in it
      $C.@TextField #Search {
        FlexWeight: 1;
        Anchor: (Height: 32);
        PlaceholderText: %server.customUI.searchPlaceholder;
      }

      // Holds the search field's place where the page hides it
      Group #ToolsSpacer { FlexWeight: 1; Visible: false; }

      // Which quest states the open list shows, hidden where there is no such list
      $C.@DropdownBox #QuestFilter {
        Anchor: (Width: 200, Height: 32, Left: 8);
        Visible: false;
      }

      // Lays the open chapter out on its grid, for players allowed to; shown in the graph only
      $C.@SmallSecondaryTextButton #EditToggle {
        @Anchor = (MinWidth: 100, Left: 8);
        Visible: false;
      }

      // Switches the chapters tab between its list and its graph
      $C.@SmallSecondaryTextButton #ViewToggle {
        @Anchor = (MinWidth: 100, Left: 8);
        Visible: false;
      }
    }

    // The trail back to the tab's list, filled by the page: it is as long as the player went deep
    Group #Breadcrumb {
      LayoutMode: Left;
      Anchor: (Height: 20, Top: 8);
    }

    $C.@ContentSeparator { Anchor: (Top: 8, Bottom: 8); }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: Left;

      // The chapters tab's table of contents: group headers and their chapters, appended flat
      Group #ChapterList {
        Anchor: (Width: 230, Right: 10);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 8);
        Visible: false;
      }

      Group #Main {
        FlexWeight: 1;
        LayoutMode: Top;

        Label #Empty { Text: ""; Anchor: (Height: 30); Visible: false; Style: (...$C.@DefaultLabelStyle, FontSize: 13, HorizontalAlignment: Center, VerticalAlignment: Center); }

        Group #QuestList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Right: 8);
        }

        // The open chapter as a graph, scrolling both ways though a container scrolls one way only:
        // rows in #GraphScroll, columns in #GraphRow inside it (shift and the wheel). The vertical one
        // is outermost, so its scrollbar stays at the edge of the area. #Graph has no layout mode: the
        // page places every node and line by its anchor, and sizes it and #GraphRow to the chapter.
        Group #GraphScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Background: #0d141f(0.5);
          Visible: false;

          Group #GraphRow {
            Anchor: (Height: 380);
            LayoutMode: LeftScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            Group #Graph { Anchor: (Width: 552, Height: 368); }
          }
        }
      }
    }
  }
}
