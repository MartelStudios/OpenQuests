// One quest. Appended into whatever container is being filled, addressed as "<container>[i] #Title".
// The header is a group of its own so a description can sit under it rather than beside it.
$Rows = "QuestTrackerCommon.ui";

Group #QuestRow {
  Anchor: (Top: 12);
  LayoutMode: Top;

  Group #Header {
    Group #IconDefault { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: $Rows.@QuestIconDefault; }
    Group #IconComplete { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: $Rows.@QuestIconComplete; Visible: false; }
    Group #IconFailed { Anchor: (Width: 14, Height: 14, Top: 4, Left: 0); Background: $Rows.@QuestIconFailed; Visible: false; }

    Label #Title { Text: ""; Anchor: (Left: 20, Width: 230); Style: $Rows.@QuestTitleStyle; }
    Label #Progress { Text: ""; Style: $Rows.@QuestProgressStyle; }
  }

  // Shown only for an asset tagged HUD_DESC
  Label #Description { Text: ""; Anchor: (Left: 20, Width: 230, Top: 2); Style: $Rows.@QuestDescriptionStyle; Visible: false; }

  // Shown only for a quest running against the clock
  Group #Timer {
    LayoutMode: Left;
    Anchor: (Top: 4, Height: 14);
    Padding: (Left: 20);
    Visible: false;

    Group #TimerTrack {
      FlexWeight: 1;
      Anchor: (Top: 3, Height: 8);
      Background: $Rows.@TimerTrack;
      Padding: 1;

      ProgressBar #TimerBar { BarTexturePath: "TimerBarFill.png"; Value: 1; }
    }

    Label #TimerText { Text: ""; Anchor: (Left: 8, Width: 52); Style: $Rows.@QuestTimerStyle; }
  }
}
