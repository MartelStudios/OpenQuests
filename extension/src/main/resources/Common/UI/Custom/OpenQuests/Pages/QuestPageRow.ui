// One quest, collapsed to a header until its toggle is pressed. Appended into #QuestList and
// addressed as "#QuestList[i] #Title".
$P = "QuestPageCommon.ui";
$C = "../../Common.ui";

Group #QuestPageRow {
  LayoutMode: Top;
  Background: #1a2233;
  Padding: (Full: 12);
  Anchor: (Bottom: 4);

  // No height of its own: categories that do not fit beside the title wrap under it and the header
  // grows with them, while everything either side keeps to the first line
  Group #Header {
    LayoutMode: Left;

    TextButton #Toggle {
      Text: "+";
      Anchor: (Width: 28, Height: 24, Top: 0);
      Style: $P.@ToggleStyle;
    }

    Group { Anchor: (Width: 8); }

    // Same mark the objectives carry, so the eye reads a quest and its steps the same way
    Group #Icon { Anchor: (Width: 12, Height: 12, Top: 6, Right: 8); }

    // The title, then the categories the page appends after it, wrapping like words on a line
    Group #TitleLine {
      LayoutMode: LeftWrap;
      FlexWeight: 1;

      Label #Title { Text: ""; Anchor: (Height: 24, Right: 8); Style: $P.@RowTitleStyle; }
    }

    // Filled by the quest own renderer, and only by it: a type with nothing to count leaves it
    // empty rather than the row pretending to a figure
    Label #Progress { Text: ""; Anchor: (Width: 90, Height: 24, Top: 0, Left: 8, Right: 16); Style: $P.@ProgressStyle; }

    Label #Status { Text: ""; Anchor: (Width: 140, Height: 24, Top: 0); Style: $P.@RowStatusStyle; }
  }

  Label #Description { Text: ""; Anchor: (Top: 4); Style: $P.@RowTextStyle; Visible: false; }

  // Every gap is the top margin of what follows it rather than a spacer after what precedes it, so
  // a hidden section takes its gap along and nothing is left trailing under the last one shown
  Group #Details {
    LayoutMode: Top;
    Visible: false;

    Label #ObjectivesHeader { Text: ""; Anchor: (Height: 16, Top: 6); Style: $P.@SectionStyle; Visible: false; }
    Group #Objectives { LayoutMode: Top; }

    Group #ConditionsSection {
      LayoutMode: Top;
      Anchor: (Top: 6);
      Visible: false;

      Label #ConditionsHeader { Text: ""; Anchor: (Height: 16); Style: $P.@SectionStyle; }
      Group #Conditions { LayoutMode: Top; }
    }

    Label #RewardsHeader { Text: ""; Anchor: (Height: 16, Top: 6); Style: $P.@SectionStyle; Visible: false; }
    Group #Rewards { LayoutMode: Top; }

    // No height of its own: it is as tall as the buttons shown, and nothing at all without one
    Group #Actions {
      LayoutMode: Left;

      // Only ever drawn over something owed, so it wears the gold outright rather than being
      // switched into it
      TextButton #Claim {
        Text: "";
        Anchor: (Width: 110, Height: $C.@SmallButtonHeight, Top: 8, Right: 8);
        Padding: (Horizontal: 16);
        Style: $P.@OwedButtonStyle;
        Visible: false;
      }

      $C.@SmallSecondaryTextButton #Abandon {
        @Anchor = (Width: 110, Top: 8, Right: 8);
        Text: "";
        Visible: false;
      }

      $C.@SmallSecondaryTextButton #Track {
        @Anchor = (Width: 110, Top: 8, Right: 8);
        Text: "";
        Visible: false;
      }
    }
  }
}

