{
  "$Comment": "Opens offers, progress reminders and completed dialogue for Tavin.",
  "Selector": {
    "Type": "Sequence",
    "Routes": [
      {
        "When": {
          "Type": "RequiresQuest",
          "QuestAssetId": "LivingWorldQuests_VeteranCaptain",
          "States": [
            "InProgress",
            "Successful"
          ],
          "Min": 0,
          "Max": 0
        },
        "Then": {
          "Dialogue": "LivingWorldQuests_VeteranCaptainOffer"
        }
      },
      {
        "When": {
          "Type": "RequiresQuest",
          "QuestAssetId": "LivingWorldQuests_VeteranCaptain",
          "States": [
            "InProgress"
          ]
        },
        "Then": {
          "Dialogue": "LivingWorldQuests_VeteranCaptainWaiting"
        }
      }
    ],
    "Default": {
      "Dialogue": "LivingWorldQuests_VeteranCaptainThanks"
    }
  }
}
